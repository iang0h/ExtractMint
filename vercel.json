{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "extractmint\\.vercel\\.app" }],
      "destination": "https://extractmint.iangoh.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "extractmint-iango\\.vercel\\.app" }],
      "destination": "https://extractmint.iangoh.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "https-bankstatementconverter-com-bu\\.vercel\\.app" }],
      "destination": "https://extractmint.iangoh.com/:path*",
      "permanent": true
    },
    {
      "source": "/convert/cimb-bank-statement-to-excel/",
      "destination": "/convert/bank-statement-to-excel/#bank-format-limitations",
      "permanent": true
    },
    {
      "source": "/convert/maybank-bank-statement-to-excel/",
      "destination": "/convert/bank-statement-to-excel/#bank-format-limitations",
      "permanent": true
    },
    {
      "source": "/convert/singapore-bank-statement-to-excel/",
      "destination": "/convert/bank-statement-to-excel/#bank-format-limitations",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
